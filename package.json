{
  "name": "novatype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NovaType — a dark, blue-dominant animated typing-speed app.",
  "author": "D3f4ul1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/D3f4ul1/NovaType"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "desktop": "npm run build && electron .",
    "icon": "electron scripts/make-icon.cjs",
    "dist:win": "npm run build && electron-packager . NovaType --platform=win32 --arch=x64 --out=release --overwrite --app-version=1.0.0 --icon=build/icon.ico --ignore=\"^/node_modules($|/)\" --ignore=\"^/(scripts|README.md|package-lock.json|tsconfig.*\\.json|postcss.config.js|tailwind.config.js|vite.config.ts)$\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "~5.1.0",
    "@fontsource-variable/jetbrains-mono": "~5.1.0",
    "@fontsource/fira-code": "~5.1.0",
    "@fontsource/roboto-mono": "~5.1.0",
    "framer-motion": "~11.11.17",
    "lucide-react": "~0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "~4.5.5"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "@vitejs/plugin-react": "~4.3.4",
    "autoprefixer": "~10.4.20",
    "electron": "^33.4.11",
    "postcss": "~8.4.49",
    "tailwindcss": "~3.4.17",
    "typescript": "~5.6.3",
    "vite": "~5.4.11"
  }
}
